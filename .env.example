# ============================================================
# Google Ads Hotel Campaigns — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-secrets-generate
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/google_ads_campaigns.db

# JWT Auth
JWT_SECRET_KEY=change-me-jwt-secret-key-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================================
# Google Ads API Credentials
# See: https://developers.google.com/google-ads/api/docs/first-call/overview
# ============================================================
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token-here
GOOGLE_ADS_CLIENT_ID=your-oauth2-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-oauth2-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=000-000-0001

# Optional: Use a service account instead of OAuth2
# GOOGLE_ADS_JSON_KEY_FILE_PATH=/path/to/service-account.json

# ============================================================
# Anthropic API (for AI auto-fill brief from hotel website)
# Get your key at: https://console.anthropic.com/settings/keys
# ============================================================
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================================
# Translation Providers (optional)
# ============================================================
TRANSLATION_PROVIDER=noop
# Options: noop | google | deepl

# Google Cloud Translation API
# GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# DeepL API
# DEEPL_API_KEY=your-deepl-api-key

# ============================================================
# CORS (for frontend)
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Default Admin User (created on first run)
# ============================================================
ADMIN_EMAIL=admin@blastness.com
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_FULL_NAME=Admin Blastness
